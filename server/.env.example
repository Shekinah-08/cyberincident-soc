JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
MAX_UPLOAD_MB=50
RATE_LIMIT_MAX=300
CLIENT_ORIGIN=http://localhost:4000

# true = laboratoire : le moteur génère automatiquement un signal SNMP simulé.
# false = production/labo réseau : SNMP_DEVICES est utilisé.
SNMP_DEMO_MODE=true
SNMP_DEMO_SCENARIO=INTERFACE_DOWN
SNMP_POLL_INTERVAL_MS=30000
SNMP_ERROR_THRESHOLD=100

# Exemple SNMPv2c :
# SNMP_DEVICES=[{"name":"SW-01","host":"192.168.1.10","community":"public","version":"2c","timeout":2000,"retries":1}]
SNMP_DEVICES=[]

# Optionnel : réception de traps SNMP sur UDP.
# SNMP_TRAP_PORT=10162
